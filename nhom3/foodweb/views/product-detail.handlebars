<div class="product-detail">
  <div class="product-detail-img">
    <img src="{{product.image}}" alt="{{product.name}}" onerror="this.onerror=null;this.src='/images/no-image.svg'">
  </div>
  <div class="product-detail-info">
    <h1>{{product.name}}</h1>
    <p class="category-tag">{{product.category}}</p>
    <p class="price-big">{{formatCurrency product.price}}</p>
    <p class="description">{{product.description}}</p>
    <p class="stock">Còn lại: {{product.stock}} phần</p>
    <form action="/cart/add" method="POST" class="add-form">
      <input type="hidden" name="productId" value="{{product.id}}">
      <label>Số lượng:</label>
      <input type="number" name="qty" value="1" min="1" max="{{product.stock}}">
      <button type="submit" class="btn-add">Thêm vào giỏ hàng</button>
    </form>
    <a href="/" class="back-link">← Quay lại trang chủ</a>
  </div>
</div>
