<h1>{{#if editMode}}Sửa sản phẩm{{else}}Thêm sản phẩm{{/if}}</h1>
<form
  action="{{#if editMode}}/admin/products/edit/{{product.id}}{{else}}/admin/products/add{{/if}}"
  method="POST"
  enctype="multipart/form-data"
  class="product-form"
>
  <label>Tên sản phẩm</label>
  <input type="text" name="name" value="{{product.name}}" required>

  <label>Danh mục</label>
  <input type="text" name="category" value="{{product.category}}" required>

  <label>Giá (VNĐ)</label>
  <input type="number" name="price" value="{{product.price}}" min="0" required>

  <label>Số lượng trong kho</label>
  <input type="number" name="stock" value="{{product.stock}}" min="0" required>

  <label>Mô tả</label>
  <textarea name="description" rows="4">{{product.description}}</textarea>

  <label>Hình ảnh {{#if editMode}}(để trống nếu giữ ảnh cũ){{/if}}</label>
  <input type="file" name="image" accept="image/*">
  {{#if product.image}}<img src="{{product.image}}" class="thumb-preview" onerror="this.onerror=null;this.src='/images/no-image.svg'">{{/if}}

  <button type="submit" class="btn-add">{{#if editMode}}Cập nhật{{else}}Thêm mới{{/if}}</button>
</form>
